
---
// src/components/BookingForm.astro
---

<section
    id="reserva"
    class="w-full bg-waza-black py-20 md:py-24 px-6 md:px-12 border-t border-waza-nori/60"
>
    <div class="max-w-xl mx-auto">

        <!-- Encabezado -->
        <div class="text-center mb-12 space-y-3">
            <h2
                class="font-serif-display text-3xl uppercase tracking-wider text-waza-white"
            >
                Reservas
            </h2>

            <p
                class="font-sans text-[10px] text-waza-red tracking-[0.2em] uppercase font-bold"
            >
                Private Sushi Experience
                <span class="text-waza-white/30 mx-1">//</span>
                Porto
            </p>
        </div>

        <!-- Formulario -->
        <form
            name="reservas-waza"
            method="POST"
            data-netlify="true"
            class="flex flex-col gap-9 font-sans"
        >
            <input
                type="hidden"
                name="form-name"
                value="reservas-waza"
            />

            <!-- Nombre -->
            <div class="flex flex-col gap-3 w-full">
                <label
                    for="name"
                    class="text-[10px] uppercase tracking-widest text-waza-mineral font-bold"
                >
                    Nome Completo
                </label>

                <input
                    type="text"
                    name="name"
                    id="name"
                    required
                    autocomplete="name"
                    class="w-full py-2 px-0 text-sm text-waza-white bg-transparent border-0 border-b border-waza-mineral/40 rounded-none focus:outline-none focus:ring-0 focus:border-waza-red transition-colors"
                />
            </div>

            <!-- Contacto -->
            <div class="flex flex-col gap-3 w-full">
                <label
                    for="contact"
                    class="text-[10px] uppercase tracking-widest text-waza-mineral font-bold"
                >
                    Contacto (WhatsApp ou Email)
                </label>

                <input
                    type="text"
                    name="contact"
                    id="contact"
                    required
                    class="w-full py-2 px-0 text-sm text-waza-white bg-transparent border-0 border-b border-waza-mineral/40 rounded-none focus:outline-none focus:ring-0 focus:border-waza-red transition-colors"
                />
            </div>

            <!-- Comensales y fecha -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 w-full">

                <!-- Comensales -->
                <fieldset class="min-w-0">
                    <legend
                        class="text-[10px] uppercase tracking-widest text-waza-mineral font-bold mb-4"
                    >
                        Comensais
                    </legend>

                    <div class="flex flex-wrap gap-2">
                        {
                            [2, 3, 4, 5, 6].map((guests) => (
                                <label class="cursor-pointer">
                                    <input
                                        type="radio"
                                        name="guests"
                                        value={guests}
                                        checked={guests === 2}
                                        class="sr-only peer"
                                    />

                                    <span
                                        class="flex items-center justify-center min-w-10 h-9 px-2 border border-waza-mineral/30 rounded-sm text-[10px] text-waza-mineral font-mono transition-all duration-300 peer-checked:border-waza-red peer-checked:text-waza-white peer-checked:bg-waza-red/10 hover:border-waza-mineral peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-waza-red"
                                    >
                                        {guests} PAX
                                    </span>
                                </label>
                            ))
                        }
                    </div>
                </fieldset>

                <!-- Fecha -->
                <div class="flex flex-col gap-3 min-w-0">
                    <label
                        for="date"
                        class="text-[10px] uppercase tracking-widest text-waza-mineral font-bold"
                    >
                        Data Pretendida
                    </label>

                    <div class="relative border-b border-waza-mineral/40 focus-within:border-waza-red transition-colors">
                        <input
                            type="date"
                            name="date"
                            id="date"
                            required
                            class="w-full min-w-0 py-2 pr-8 pl-0 text-sm text-waza-white bg-transparent border-0 rounded-none focus:outline-none focus:ring-0 cursor-pointer [color-scheme:dark]"
                        />

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="17"
                            height="17"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="absolute right-0 top-1/2 -translate-y-1/2 text-waza-mineral pointer-events-none"
                            aria-hidden="true"
                        >
                            <rect x="3" y="5" width="18" height="16" rx="2" />
                            <path d="M16 3v4M8 3v4M3 10h18" />
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Ubicación -->
            <div class="flex flex-col gap-3 w-full">
                <label
                    for="location"
                    class="text-[10px] uppercase tracking-widest text-waza-mineral font-bold"
                >
                    Local do Serviço (Porto e Arredores)
                </label>

                <input
                    type="text"
                    name="location"
                    id="location"
                    required
                    placeholder="Ex.: Porto, Matosinhos, Gaia..."
                    class="w-full py-2 px-0 text-sm text-waza-white placeholder:text-waza-mineral/50 bg-transparent border-0 border-b border-waza-mineral/40 rounded-none focus:outline-none focus:ring-0 focus:border-waza-red transition-colors"
                />
            </div>

            <!-- Restricciones -->
            <div class="flex flex-col gap-3 w-full">
                <label
                    for="notes"
                    class="text-[10px] uppercase tracking-widest text-waza-mineral font-bold"
                >
                    Restrições Alimentares ou Notas
                </label>

                <textarea
                    name="notes"
                    id="notes"
                    rows="2"
                    placeholder="Alergias, intolerâncias ou informações adicionais..."
                    class="w-full py-2 px-0 text-sm text-waza-white placeholder:text-waza-mineral/50 bg-transparent border-0 border-b border-waza-mineral/40 rounded-none focus:outline-none focus:ring-0 focus:border-waza-red transition-colors resize-none"
                ></textarea>
            </div>

            <!-- Información del servicio -->
            <div class="text-center space-y-3 pt-3">
                <p
                    class="text-[10px] uppercase tracking-[0.2em] text-waza-red font-bold"
                >
                    Informações sobre o Serviço
                </p>

                <p
                    class="text-xs md:text-sm text-waza-mineral leading-relaxed max-w-md mx-auto"
                >
                    Serviço disponível no Porto e arredores.
                    Outras localizações sujeitas a consulta.
                    Antes da confirmação, solicitaremos algumas
                    fotografias da cozinha onde será realizada a experiência.
                </p>
            </div>

            <!-- Botón compacto -->
            <div class="flex justify-center pt-3">
                <button
                    type="submit"
                    class="inline-flex items-center justify-center w-auto max-w-full px-7 py-3 border border-waza-red bg-transparent text-waza-white hover:bg-waza-red text-[10px] md:text-xs font-sans font-bold tracking-[0.16em] uppercase transition-all duration-300 rounded-sm cursor-pointer"
                >
                    Consultar Disponibilidade
                </button>
            </div>

        </form>
    </div>
</section>

<!-- Footer REN WAZA -->
<footer class="ren-footer">
    <div class="footer-content">
        <div class="footer-brand">
            <span class="brand-main">REN</span>
            <span class="brand-sub">WAZA</span>
        </div>

        <div class="footer-info">
            <p class="footer-artisan">Handmade Sushi</p>
            <p class="footer-location">Porto, PT</p>
        </div>

        <div class="footer-contact">
            <div class="contact-group">
                <a
                    href="mailto:augusto@renwaza.com"
                    class="footer-link"
                >
                    augusto@renwaza.com
                </a>

                <a
                    href="https://www.instagram.com/renwaza"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer-link instagram-link"
                >
                    @renwaza
                </a>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <p>&copy; 2026 REN Waza. All rights reserved.</p>
    </div>
</footer>

<script>
    // Abre el calendario al pulsar cualquier parte del campo.
    const dateInput = document.querySelector<HTMLInputElement>(
        '#reserva input[type="date"]'
    );

    if (dateInput) {
        // Evita seleccionar fechas anteriores a hoy.
        const today = new Date();
        const localDate = new Date(
            today.getTime() - today.getTimezoneOffset() * 60000
        ).toISOString().split('T')[0];

        dateInput.min = localDate;

        dateInput.addEventListener('click', () => {
            if (typeof dateInput.showPicker === 'function') {
                try {
                    dateInput.showPicker();
                } catch {
                    // El navegador mantiene su selector nativo.
                }
            }
        });
    }
</script>
